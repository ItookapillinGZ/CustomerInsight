# Only copy when .env does not exist. Never overwrite filled values or commit .env.
LLM_PROVIDER=openai_compatible
# Required: fill your own key before starting analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
# Blank uses the SDK's OpenAI endpoint; set your compatible gateway's full /v1 URL.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=4096
# Blank omits reasoning. Support depends on the actual model/provider.
OPENAI_REASONING_EFFORT=
# Explicit selection. Provider name does not imply Responses or strict-schema support.
API_MODE=chat_completions
# Chat only: json_schema / json_object / text. All are locally Pydantic-validated.
CHAT_OUTPUT_MODE=json_object
# Chat only: max_completion_tokens / max_tokens. Never send both.
CHAT_TOKEN_PARAMETER=max_completion_tokens
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1

# Customer-facing app (app.py). Grouped requests follow v3 rules, no retries.
# Daily caps are request counts, not monetary budgets; Beijing calendar days.
APP_DAILY_REQUEST_LIMIT=50
APP_USAGE_DB_PATH=.runtime/product_usage.sqlite3
# Original workbooks, reports and chats are stored locally here; Docker uses /data/customerinsight.
APP_DATA_DIR=.runtime/history
# Up to 10 distinct reviews share one request; long text uses smaller groups.
APP_LLM_BATCH_SIZE=10
APP_LLM_BATCH_MAX_CHARACTERS=12000
# Local use: false. Internet/remote use: true and set a long private access code.
APP_PUBLIC_MODE=false
APP_ACCESS_PASSWORD=
# Docker defaults to localhost. Set 0.0.0.0 only with access protection.
APP_BIND_HOST=127.0.0.1
APP_PORT=8501
# Optional independent FastAPI service. Use a separate long random token.
# All data endpoints require Bearer authentication, including local mode.
APP_API_TOKEN=
APP_API_PORT=8000
# Optional durable queue deployment (compose.jobs.yml sets these in containers).
# Local Streamlit defaults to direct; queued requires the API, Redis and Worker.
APP_ANALYSIS_MODE=direct
APP_API_URL=http://127.0.0.1:8000
APP_REDIS_URL=redis://redis:6379/0
# Shared upstream permits for queued analysis and Agent calls; not user accounts.
APP_GLOBAL_INFLIGHT=2
APP_DISPATCH_INTERVAL_SECONDS=5
# Default lease is max(120, OPENAI_TIMEOUT_SECONDS + 60); normally leave unset.
# APP_JOB_LEASE_SECONDS=120
# Account deployment: compose.production.yml injects APP_DATABASE_URL into the backend.
# APP_UI_MODE=api enables the HTTP-only page (set by production Compose).
# Keep APP_DATABASE_URL unset locally to retain legacy SQLite mode.
# APP_DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/customerinsight
APP_POSTGRES_PASSWORD=
# Optional HTTPS reverse proxy; use your own domain with DNS pointing to server.
# APP_DOMAIN=reviews.your-domain.example
